# Chamfer environment configuration
#
# Copy this file to .env (shared defaults) or .env.local (personal, git-ignored)
# next to where you run `chamfer` / `npm run dev`. Chamfer looks for these files
# in the current directory, then walks up to the nearest directory that has one.
#
# Precedence, highest first:
#   1. Settings saved in the app's Settings dialog (stored in the local database)
#   2. Real environment variables exported in your shell
#   3. .env.local
#   4. .env
#
# Values from these files show up pre-filled in the Settings dialog with a
# `.env` badge; anything you change there is saved as an override and can be
# reverted with "Reset to .env".

# ---------------------------------------------------------------------------
# LLM provider credentials (set at least the one your model needs)
# ---------------------------------------------------------------------------

# Anthropic API key, from https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: custom Anthropic-compatible endpoint (proxy or gateway).
# Leave unset to use the official API.
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI API key, from https://platform.openai.com/api-keys
#OPENAI_API_KEY=sk-proj-...

# Optional: custom OpenAI-compatible endpoint.
#OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API key, from https://aistudio.google.com/apikey
# GEMINI_API_KEY is accepted as an alias; GOOGLE_API_KEY wins if both are set.
#GOOGLE_API_KEY=AIza...
#GEMINI_API_KEY=AIza...

# Optional: custom Gemini-compatible endpoint.
#GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------
# Default model
# ---------------------------------------------------------------------------

# Model id to use, e.g. claude-sonnet-5, gpt-5, gemini-3-pro.
# The full list is what the Settings dialog's model picker shows.
#CHAMFER_MODEL=claude-sonnet-5

# Provider of CHAMFER_MODEL: anthropic | openai | google.
# Only needed when the same model id exists under more than one provider.
#CHAMFER_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Agent limits
# ---------------------------------------------------------------------------

# Safety cap: the agent aborts a turn after this many build123d executions
# (default 10). There is no other turn or token limit. Positive integer.
#CHAMFER_MAX_CAD_RUNS=10

# ---------------------------------------------------------------------------
# Chat display
# ---------------------------------------------------------------------------

# Show the agent's CAD code (build123d Python) in the chat window. Hidden by
# default: code blocks collapse to a "CAD code" row with Copy / Render 3D.
# Set to 1 to render the code bodies.
#CHAMFER_SHOW_CAD_CODE=1

# Expose Autodesk Fusion to controlled testers even when the current release
# integrity verdict is no-go. The verdict and limitations remain visible.
#CHAMFER_EXPERIMENTAL_FUSION=1

# Exact loopback MCP endpoint for the locally running Autodesk Fusion adapter.
# Only http://127.0.0.1:<port>/mcp is accepted.
#CHAMFER_FUSION_MCP_ENDPOINT=http://127.0.0.1:27182/mcp

# Optional JSON report produced by `npm run fusion:integrity -- --create-disposable`.
# Atomicity is fail-closed unless the report matches the endpoint and passed rollback checks.
#CHAMFER_FUSION_INTEGRITY_REPORT=/absolute/path/to/fusion-integrity-report.json

# Versioned release gate produced by `npm run fusion:gate`. Without the
# experimental override, Fusion is selectable only when this complete zero-
# failure report names the exact running CLI server artifact. The published CLI
# computes CHAMFER_RELEASE_ARTIFACT_SHA256 itself; repo/development servers may
# set it explicitly when validating a built artifact.
#CHAMFER_FUSION_RELEASE_INTEGRITY_REPORT=/absolute/path/to/fusion-release-integrity.json
#CHAMFER_RELEASE_ARTIFACT_SHA256=64-lowercase-hex-characters

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Chamfer server listens on (default 8787; --port beats this).
#PORT=8787

# Where Chamfer stores its database (default ~/.chamfer for the CLI,
# the repo-local data/ dir for `npm run dev`).
#CHAMFER_DATA_DIR=/path/to/data

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------

# Langfuse LLM tracing (https://langfuse.com). When both keys are set, every
# LLM call the server makes (chat turns and title generation) is recorded as
# a Langfuse trace with input, output, token usage, and cost. Leave unset to
# run without tracing - Chamfer works exactly the same either way.
# Create keys under Project Settings > API Keys in Langfuse. Unlike the
# values above, these are read from the environment only and do not appear
# in the Settings dialog.
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...

# Langfuse host. Defaults to Langfuse Cloud EU. Use
# https://us.cloud.langfuse.com for the US region, or your self-hosted URL.
#LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Development / testing
# ---------------------------------------------------------------------------

# Set to 1 to replace the real LLM with a scripted fake (used by the e2e
# suite). Never needed for normal use.
#CHAMFER_FAKE_LLM=1
