    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@hono/node-server": "^1.13.0",
    "@langfuse/client": "5.9.1",
    "@langfuse/core": "5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@lezer/python": "^1.1.19",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "hono": "^4.6.0",
    "lru-cache": "^10.4.3",
    "pi-mcp-adapter": "2.11.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^3.0.0"
  }
}
