{
  "name": "@chamfer/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "fusion:integrity": "tsx src/fusion/runIntegrityProbe.ts",
    "fusion:gate": "tsx src/fusion/runReleaseIntegrityGate.ts",
    "fusion:evaluate": "tsx src/fusion/runEvaluation.ts",
    "eval:sync": "tsx src/evaluation/syncOfflineExperimentCommand.ts",
    "eval:sync-reviews": "tsx src/evaluation/syncOnlineReviewQueueCommand.ts",
    "start": "tsx src/index.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@chamfer/fusion-fixtures": "*",
    "@chamfer/shared": "*",
    "@earendil-works/pi-agent-core": "^0.81.1",
