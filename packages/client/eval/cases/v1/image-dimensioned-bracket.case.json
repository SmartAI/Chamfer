{
  "schemaVersion": 1,
  "id": "image.dimensioned-bracket",
  "version": 1,
  "title": "Dimensioned orthographic mounting bracket",
  "purpose": "Measure extraction and deterministic enforcement of dimensions and holes from an orthographic reference.",
  "capability": "dimensioned-orthographic-specification",
  "modality": "image",
  "complexity": "standard",
  "complexityRationale": "Two orthographic views encode an envelope, thickness, four feature dimensions, and a pattern that must map into plan checks.",
  "categories": ["image", "orthographic", "dimensions"],
  "gatingStatus": "release",
  "capabilityStatus": "supported",
  "inputs": {
    "turns": [{
      "role": "user",
      "text": "Build the dimensioned mounting bracket shown in this synthetic orthographic drawing and verify every readable requirement.",
      "assetIds": ["bracket-drawing"]
    }],
    "assets": [{
      "id": "bracket-drawing",
      "path": "assets/dimensioned-bracket.png",
      "mimeType": "image/png",
      "sha256": "9fb6365cb9161aa20110aaad67524129f803086caa28eaa36992cf9adf47447c",
      "provenance": "synthetic",
      "expectedRole": "dimensioned-orthographic",
      "provenanceNotes": "Authored as a dimensioned SVG drawing solely for this corpus."
    }]
  },
  "expectedOutcome": {
    "kind": "completed",
    "requirements": [
      {
        "id": "envelope",
        "description": "The bracket envelope is 60 by 40 by 8 mm.",
        "evaluation": { "kind": "deterministic", "evaluatorId": "bbox" }
      },
      {
        "id": "holes",
        "description": "The final part contains four 6 mm through holes.",
        "evaluation": { "kind": "deterministic", "evaluatorId": "gate-checks" }
      },
      {
        "id": "mapped-plan",
        "description": "Every readable drawing specification is represented in the accepted plan.",
        "evaluation": { "kind": "deterministic", "evaluatorId": "plan-conformance" }
      },
      {
        "id": "drawing-intent",
        "description": "The final form agrees with both orthographic views rather than merely passing geometry checks.",
        "evaluation": { "kind": "semantic", "rubricId": "visual-form" }
      }
    ]
  },
  "requiredEvidence": [
    { "id": "verification-gate", "kind": "verification-gate", "evaluatorId": "verification-gate" },
    { "id": "envelope", "kind": "geometry-measurement", "evaluatorId": "bbox" },
    { "id": "holes", "kind": "geometry-measurement", "evaluatorId": "gate-checks" },
    { "id": "mapped-plan", "kind": "plan-check", "evaluatorId": "plan-conformance" },
    { "id": "visual-evidence", "kind": "visual-verification", "evaluatorId": "visual-verification" }
  ],
  "forbiddenOutcomes": [
    { "kind": "requirement-weakening", "reason": "Unread or omitted drawing dimensions cannot be silently discarded." },
    { "kind": "stale-evidence-success", "reason": "Visual verification must cover the current artifact and drawing." }
  ],
  "evaluatorRefs": [
    { "id": "verification-gate", "version": 1, "required": true, "config": {} },
    { "id": "bbox", "version": 1, "required": true, "config": { "expectedMm": [60, 40, 8], "toleranceMm": 0.5 } },
    { "id": "gate-checks", "version": 1, "required": true, "config": { "names": ["check:hole_through[0]"] } },
    { "id": "plan-conformance", "version": 1, "required": true, "config": { "minimumSpecRows": 3 } },
    { "id": "visual-verification", "version": 1, "required": true, "config": { "minimumReferences": 1 } }
  ],
  "rubricRefs": [{ "id": "visual-form", "version": 1, "required": true }],
  "sourceSafety": {
    "classification": "synthetic",
    "containsProductionData": false,
    "notes": "The SVG drawing was authored for the evaluation corpus and has no outside source."
  }
