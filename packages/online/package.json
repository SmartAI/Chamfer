{
  "name": "@chamfer/online",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "npm run build:online --workspace @chamfer/client",
    "build:container-context": "node container/build.mjs",
    "container:push": "node scripts/container-push.mjs",
    "predev": "node container/build.mjs && node scripts/dev-config.mjs",
    "dev": "wrangler dev --config .wrangler.dev.jsonc",
    "deploy": "wrangler deploy",
    "test": "vitest --run",
    "probe:llm-proxy": "node scripts/llm-proxy-probe.mjs",
    "e2e:hosted-turns": "node scripts/hosted-turns-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@chamfer/server": "*",
    "@chamfer/shared": "*",
    "@cloudflare/containers": "^0.3.7",
    "@earendil-works/pi-ai": "^0.81.1",
    "@sentry/cloudflare": "^10.67.0",
    "better-auth": "^1.3.0",
    "eventsource-parser": "^3.1.0",
    "hono": "^4.6.0",
    "image-size": "^2.0.2",
    "jose": "^6.2.4",
    "kysely": "^0.28.0",
    "kysely-d1": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@types/node": "^22.10.0",
    "playwright-core": "^1.57.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.112.0"
  }
}
