{
  "name": "chamfer-v2",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev -w @chamfer/server",
    "dev:client": "npm run dev -w @chamfer/client",
    "eval:sync": "npm run eval:sync -w @chamfer/server --",
    "eval:sync-reviews": "npm run eval:sync-reviews -w @chamfer/server --",
    "build": "npm run build -w @chamfer/shared && npm run build -w @chamfer/fusion-fixtures && npm run build -w @chamfer/client && npm run build -w @chamfer/server && npm run build -w chamfer",
    "build:online": "npm run build -w @chamfer/shared && npm run build:online -w @chamfer/client",
    "deploy:online": "npm run build:online && wrangler deploy --config packages/online/wrangler.jsonc",
    "start": "npm run start -w @chamfer/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "fusion:integrity": "npm run fusion:integrity -w @chamfer/server --",
    "fusion:gate": "npm run fusion:gate -w @chamfer/server --",
    "fusion:evaluate": "npm run fusion:evaluate -w @chamfer/server --",
    "eval:proven-single-part": "npm run start -w @chamfer/evaluation --"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
