{
  "name": "chamfer-v2",
  "private": true,
  "license": "Apache-2.0",
  "engines": { "node": ">=22.19.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev -w @chamfer/server",
    "dev:client": "npm run dev -w @chamfer/client",
    "build": "npm run build -w @chamfer/shared && npm run build -w @chamfer/client && npm run build -w @chamfer/server",
    "start": "npm run start -w @chamfer/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
